# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (used for self-referential links, OAuth callbacks).
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing JWT tokens (change in production!)
# JWT_SECRET="my-secret-key"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI: Required for Google Drive backup.
# GOOGLE_CLIENT_ID="xxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-xxxxx"
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/backups/gdrive/callback"

# DATA_DIR: Directory for SQLite database + backups (default: /data on Fly.io, ./data on local)
# DATA_DIR="/data"

# SUPABASE_URL: URL de votre projet Supabase (ex: https://xxxxx.supabase.co)
# SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Clé anonyme Supabase (publique, utilisable côté client)
# SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Clé service Supabase (NE JAMAIS exposer côté client)
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SYNC_INTERVAL_MS: Intervalle de synchronisation automatique en millisecondes (défaut: 300000 = 5 min)
# SYNC_INTERVAL_MS="300000"
